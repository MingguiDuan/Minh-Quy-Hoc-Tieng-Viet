"classes": [
"ngang",
"huyền",
"sắc",
"hỏi/ngã",
"nặng"
],
"desc": [
[
"ngang（平）",
"高而平，不升不降。"
],
[
"huyền（`）",
"低而缓降，比 ngang 低。"
],
[
"sắc（´）",
"从中升到高，干脆上扬。"
],
[
"hỏi / ngã（? ~）",
"南部合并：低起，先略降再升，像带疑问的拖音。"
],
[
"nặng（.）",
"低而短促，突然收住。"
]
],
"intonation": [
{
"id": "i1",
"vi": "Em khỏe.",
"zh": "我很好。",
"note": "陈述句：句尾自然下落。"
},
{
"id": "i2",
"vi": "Em khỏe không?",
"zh": "你好吗？",
"note": "không 放句末表疑问，声调 ngang 略抬高。"
},
{
"id": "i3",
"vi": "Cái này bao nhiêu?",
"zh": "这个多少钱？",
"note": "疑问词在句中，句尾不必刻意上扬。"
},
{
"id": "i4",
"vi": "Anh chờ chút nha.",
"zh": "请稍等哦。",
"note": "南部常用 nha 收尾，语气软，轻读。"
},
{
"id": "i5",
"vi": "Mắc quá! Bớt được không?",
"zh": "太贵了！能便宜点吗？",
"note": "前一句短促下落，后一句疑问；注意两句之间的停顿。"
}
]
},
"dialogues": [
{
"id": "d1",
"title": "问候与称呼",
"note": "先判断年龄和关系再选称呼：anh（兄/年长男）、chị（姐/年长女）、em（弟妹/年幼者）。dạ 是礼貌应答词，对年长者常用。",
"lines": [
{
"id": "d1-1",
"who": "A",
"vi": "Chào anh.",
"zh": "你好（哥）。",
"en": "Hello (to an older man)."
},
{
"id": "d1-2",
"who": "B",
"vi": "Chào em. Em khỏe không?",
"zh": "你好。你好吗？",
"en": "Hello. Are you well?"
},
{
"id": "d1-3",
"who": "A",
"vi": "Dạ, em khỏe. Còn anh?",
"zh": "嗯，我很好。你呢？",
"en": "Yes, I am well. And you?"
},
{
"id": "d1-4",
"who": "B",
"vi": "Anh cũng khỏe. Cảm ơn em.",
"zh": "我也很好。谢谢。",
"en": "I am well too. Thank you."
}
]
},
{
"id": "d2",
"title": "点单与问价",
"note": "南部常说 ly（杯）。cà phê sữa đá = 冰奶咖啡。",
"lines": [
{
"id": "d2-1",
"who": "A",
"vi": "Cho em một ly cà phê sữa đá.",
"zh": "请给我一杯冰奶咖啡。",
"en": "One iced milk coffee, please."
},
{
"id": "d2-2",
"who": "B",
"vi": "Dạ, anh chờ chút nha.",
"zh": "好的，请稍等。",
"en": "Sure, please wait a moment."
},
{
"id": "d2-3",
"who": "A",
"vi": "Bao nhiêu tiền anh?",
"zh": "多少钱？",
"en": "How much?"
},
{
"id": "d2-4",
"who": "B",
"vi": "Dạ, ba mươi lăm nghìn.",
"zh": "三万五千盾。",
"en": "Thirty-five thousand dong."
}
]
},
{
"id": "d3",
"title": "请对方重复",
"note": "giùm 是南部常用的“帮忙”。听不懂时先说这两句，别沉默。",
"lines": [
{
"id": "d3-1",
"who": "A",
"vi": "Anh nói chậm lại được không?",
"zh": "你能说慢一点吗？",
"en": "Could you speak more slowly?"
},
{
"id": "d3-2",
"who": "A",
"vi": "Anh nói lại giùm em được không?",
"zh": "你能再说一遍吗？",
"en": "Could you say that again?"
}
]
},
{
